+import {useEffect, useState, type ComponentProps} from 'react';
+import {Platform, StyleSheet, Text, View} from 'react-native';
+import {MaterialCommunityIcons as Icon} from '@expo/vector-icons';
+import {STATUS_BAR_HEIGHT} from '../components/StatusBar';
+import Colors from '../config/Colors';
+import {testProperties} from '../config/TestProperties';
+
+/**
+ * Captured before `emulate clock` replaces window.setInterval. Fake timers
+ * do not advance on their own, so a timer started after that patch never
+ * fires. This one keeps reading the (possibly faked) Date.
+ */
+const nativeSetInterval =
+  typeof window !== 'undefined' ? window.setInterval.bind(window) : setInterval;
+const nativeClearInterval =
+  typeof window !== 'undefined'
+    ? window.clearInterval.bind(window)
+    : clearInterval;
+
+type Place = {
+  name: string;
+  lat: number;
+  lon: number;
+  temp: number;
+  condition: string;
+  icon: ComponentProps<typeof Icon>['name'];
+};
+
+const PLACES: Place[] = [
+  {name: 'Reykjavík', lat: 64.1466, lon: -21.9426, temp: -2, condition: 'Snow', icon: 'weather-snowy'},
+  {name: 'Berlin', lat: 52.52, lon: 13.405, temp: 11, condition: 'Cloudy', icon: 'weather-cloudy'},
+  {name: 'New York', lat: 40.7128, lon: -74.006, temp: 18, condition: 'Clear', icon: 'weather-sunny'},
+  {name: 'Tokyo', lat: 35.6762, lon: 139.6503, temp: 21, condition: 'Rain', icon: 'weather-rainy'},
+  {name: 'Singapore', lat: 1.3521, lon: 103.8198, temp: 31, condition: 'Humid', icon: 'weather-pouring'},
+  {name: 'Sydney', lat: -33.8688, lon: 151.2093, temp: 23, condition: 'Clear', icon: 'weather-sunny'},
+];
+
+function nearest(lat: number, lon: number) {
+  let best = PLACES[0];
+  let bestDistance = Infinity;
+  for (const place of PLACES) {
+    const distance = (place.lat - lat) ** 2 + (place.lon - lon) ** 2;
+    if (distance < bestDistance) {
+      best = place;
+      bestDistance = distance;
+    }
+  }
+  return best;
+}
+
+function formatCoord(value: number, positive: string, negative: string) {
+  const hemisphere = value >= 0 ? positive : negative;
+  return `${Math.abs(value).toFixed(2)}° ${hemisphere}`;
+}
+
+const WeatherScreen = () => {
+  const [now, setNow] = useState(() => new Date());
+  const [coords, setCoords] = useState<{lat: number; lon: number} | null>(null);
+
+  useEffect(() => {
+    let stop = false;
+    const read = () => {
+      if (stop) {
+        return;
+      }
+      setNow(new Date());
+      const geo = typeof navigator !== 'undefined' ? navigator.geolocation : undefined;
+      if (!geo?.getCurrentPosition) {
+        return;
+      }
+      geo.getCurrentPosition(
+        position => {
+          if (stop) {
+            return;
+          }
+          setCoords({
+            lat: position.coords.latitude,
+            lon: position.coords.longitude,
+          });
+        },
+        () => {},
+        {maximumAge: 0, timeout: 4000, enableHighAccuracy: false},
+      );
+    };
+    read();
+    const id = nativeSetInterval(read, 400);
+    return () => {
+      stop = true;
+      nativeClearInterval(id);
+    };
+  }, []);
+
+  const hour = now.getHours();
+  const isDay = hour >= 7 && hour < 19;
+  const place = coords ? nearest(coords.lat, coords.lon) : null;
+  const time = now.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});
+  const sky = isDay ? styles.daySky : styles.nightSky;
+  const ink = isDay ? '#16324F' : '#F4F1DE';
+  const iconName = isDay ? place?.icon ?? 'weather-sunny' : 'weather-night';
+
+  return (
+    <View style={styles.screen} {...testProperties('Weather-screen')}>
+      <View style={[styles.widget, sky]} accessibilityLabel={isDay ? 'day' : 'night'}>
+        <View style={styles.skyRow}>
+          <View style={[styles.orb, isDay ? styles.sun : styles.moon]} />
+          {!isDay && (
+            <>
+              <View style={[styles.star, {top: 18, left: 150}]} />
+              <View style={[styles.star, {top: 58, left: 210}]} />
+              <View style={[styles.star, {top: 22, left: 250}]} />
+            </>
+          )}
+          <Icon name={iconName} size={42} color={ink} />
+        </View>
+        <Text style={[styles.temp, {color: ink}]}>
+          {place ? `${place.temp}°` : '--°'}
+        </Text>
+        <Text style={[styles.city, {color: ink}]} {...testProperties('weather-city')}>
+          {place ? place.name : 'Set a location'}
+        </Text>
+        <Text style={[styles.condition, {color: ink}]}>
+          {place ? place.condition : 'Waiting for geolocation'}
+        </Text>
+        <Text style={[styles.time, {color: ink}]} {...testProperties('weather-time')}>
+          {time}
+        </Text>
+        <Text style={[styles.coords, {color: ink}]}>
+          {coords
+            ? `${formatCoord(coords.lat, 'N', 'S')}   ${formatCoord(coords.lon, 'E', 'W')}`
+            : 'No coordinates yet'}
+        </Text>
+      </View>
+    </View>
+  );
+};
+
+const styles = StyleSheet.create({
+  screen: {
+    flex: 1,
+    marginTop: STATUS_BAR_HEIGHT,
+    alignItems: 'center',
+    justifyContent: 'center',
+    backgroundColor: Colors.lighter,
+    padding: 24,
+  },
+  widget: {
+    width: Platform.OS === 'web' ? 420 : '100%',
+    maxWidth: 440,
+    minHeight: 460,
+    borderRadius: 28,
+    paddingHorizontal: 28,
+    paddingVertical: 36,
+    overflow: 'hidden',
+    alignItems: 'flex-start',
+    justifyContent: 'flex-end',
+  },
+  daySky: {
+    backgroundColor: '#7EC8E3',
+  },
+  nightSky: {
+    backgroundColor: '#0B1D36',
+  },
+  skyRow: {
+    position: 'absolute',
+    top: 28,
+    left: 28,
+    right: 28,
+    height: 120,
+    flexDirection: 'row',
+    justifyContent: 'flex-end',
+    alignItems: 'flex-start',
+  },
+  orb: {
+    position: 'absolute',
+    top: 8,
+    left: 8,
+    width: 86,
+    height: 86,
+    borderRadius: 43,
+  },
+  sun: {
+    backgroundColor: '#F6C445',
+  },
+  moon: {
+    backgroundColor: '#F4F1DE',
+  },
+  star: {
+    position: 'absolute',
+    width: 6,
+    height: 6,
+    borderRadius: 3,
+    backgroundColor: '#F4F1DE',
+  },
+  temp: {
+    fontSize: 84,
+    fontWeight: '200',
+    lineHeight: 92,
+  },
+  city: {
+    fontSize: 32,
+    fontWeight: '500',
+    marginTop: 4,
+  },
+  condition: {
+    fontSize: 20,
+    marginTop: 4,
+    opacity: 0.85,
+  },
+  time: {
+    fontSize: 28,
+    fontWeight: '300',
+    marginTop: 18,
+  },
+  coords: {
+    fontSize: 14,
+    marginTop: 8,
+    letterSpacing: 0.4,
+    opacity: 0.8,
+  },
+});
+
+export default WeatherScreen;
