// Test reporter for stdout.
    // The only one supported by default is 'dot'
    // see also: https://webdriver.io/docs/dot-reporter<%
if (reporters.length) { %><% if (reporters.includes('video')) { %>
    // the video reporter needs ffmpeg: https://webdriver.io/docs/video-reporter#install-ffmpeg<% } %><% if (reporters.includes('html')) { %>
    // the html reporter writes an HTML report for each worker; for one report of
    // all workers, see https://webdriver.io/docs/html-reporter<% } %>
    reporters: [<%- reporters.map(reporter => {
        if (reporter === 'allure') {
            return `['${reporter}', {outputDir: 'allure-results'}]`
        } else if (reporter === 'html') {
            return `['html', { outputDir: './reports/html-reports/', produceHtml: true }]`
        } else {
            return `'${reporter}'`
        }
    }) %>],<% } else { %>
    // reporters: ['dot'],<%
    }
%>
