{
  "name": "eslint-plugin-wdio",
  "version": "10.0.0",
  "description": "Eslint rules for WebdriverIO",
  "author": "Christian Bromann <mail@bromann.dev>",
  "homepage": "https://github.com/webdriverio/webdriverio/tree/main/packages/eslint-plugin-wdio",
  "license": "MIT",
  "main": "./build/index.cjs",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    }
  },
  "type": "module",
  "typeScriptVersion": "6.0.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdriverio/webdriverio.git",
    "directory": "packages/eslint-plugin-wdio"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "webdriver",
    "wdio"
  ],
  "bugs": {
    "url": "https://github.com/webdriverio/webdriverio/issues"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@wdio/types": "workspace:*",
    "eslint": "^10.11.0",
    "expect-webdriverio": "^8.0.0-alpha.3",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.71.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "globals": "^16.5.0 || ^17.0.0",
    "typescript-eslint": "^8.56.0"
  },
  "peerDependenciesMeta": {
    "typescript-eslint": {
      "optional": true
    }
  }
}
